# meal_rf_finger 로컬 DB (이 파일을 복사해 `.env` 로 저장한 뒤 값만 수정)
# 앱·apply_schema 가 시작 시 자동으로 읽습니다. MEAL_* 키는 .env 에서 로드됩니다.

MEAL_DB_HOST=127.0.0.1
MEAL_DB_PORT=3306
MEAL_DB_USER=root
MEAL_DB_PASSWORD=
MEAL_DB_NAME=meal_rf_finger

# F22 출퇴근 수신: live(기본, pyzk 4370) | poll(주기 pull) | adms(HTTP PUSH, ADMS 전용 단말)
# MEAL_F22_ATT_MODE=adms
# MEAL_ADMS_PUSH_HOST=0.0.0.0
# MEAL_ADMS_PUSH_PORT=8088
# 프린터·경광등: 출입 시각이 지금으로부터 N초 이내일 때만 (저장된 rtlog 재전송 제외, 기본 90)
# MEAL_LIVE_DEVICE_MAX_AGE_SEC=90
# 경광등 Q-Light (TCP, 기본 포트 20000 — 장치·설정에 맞게 변경)
# QLIGHT_OK_SOUND=1       성공(녹색) 부저 (기본 1, meal_manage 동일). 0 이면 무음
# QLIGHT_ALERT_SOUND=2    실패(빨강) 부저
# QLIGHT_LAMP_PULSE_SEC=1.0  램프 점등 시간(초) 후 자동 OFF
# QLIGHT_BUZZER_PULSE_SEC=0.25  (구버전 호환, LAMP 미설정 시 사용)
